# Rutia · configuración de ejemplo. Copia este archivo como .env en esta misma carpeta
# (la raíz del repositorio) y completa los valores. NUNCA subas el .env real: está en .gitignore.

# --- Backend (obligatorio) ---
# Conexión a PostgreSQL.
# Supabase: Project → Connect → "Session pooler" (puerto 5432). Agrega ?sslmode=require al final.
# Si la contraseña tiene caracteres especiales (@ : / # ? %), escríbelos codificados (@ = %40).
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Backend (opcionales: estos son sus valores por defecto) ---
# URL con la que los clientes ven este backend (se usa para armar la URL de las fotos).
# Para probar la app en un celular, usa la IP local del notebook: http://192.168.x.x:8000
PUBLIC_BASE_URL=http://localhost:8000

# Orígenes web permitidos (CORS), separados por coma. La app nativa no lo necesita.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Detalle de los registros del servidor: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# --- Solo para pytest (opcional) ---
# Base que se puede BORRAR, distinta de DATABASE_URL: las pruebas la recrean desde cero.
# TEST_DATABASE_URL=postgresql://usuario:clave@localhost:5432/rutia_pruebas
