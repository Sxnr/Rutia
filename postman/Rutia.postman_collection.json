        {
          "name": "1. Crear lugar (POST → 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/lugares",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "lugares"
              ]
            },
            "description": "Crea un lugar nuevo y guarda su id en lugar_id. Si responde 409, el lugar quedó de un ensayo anterior: ejecuta 4. Borrar lugar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"barrio-lastarria\",\n  \"categoria\": \"patrimonio\",\n  \"nombre_es\": \"Barrio Lastarria\",\n  \"nombre_en\": \"Lastarria Neighborhood\",\n  \"descripcion_es\": \"Barrio patrimonial con cafés, librerías y galerías.\",\n  \"descripcion_en\": \"Heritage neighborhood with cafés, bookshops and galleries.\",\n  \"comuna\": \"Santiago\",\n  \"latitud\": -33.4372,\n  \"longitud\": -70.6386,\n  \"costo_clp\": 0,\n  \"duracion_min\": 45,\n  \"horario_es\": \"Lun-Dom 10:00-20:00\",\n  \"horario_en\": \"Mon-Sun 10:00-20:00\",\n  \"contenido_rotativo\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"lugar_id\", pm.response.json().id);",
                  "pm.test(\"Devuelve cabecera Location\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ]
        },
