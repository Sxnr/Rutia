            "description": "Turista con 4 horas, $15.000 e interés en museos y restaurantes (caso de uso del Hito 1). Sin 'cantidad', el servidor busca 4 lugares por las 4 horas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tiempo_horas\": 4,\n  \"presupuesto_clp\": 15000,\n  \"intereses\": [\"museos\", \"restaurantes\"],\n  \"usuario_id\": {{usuario_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().paradas.map(p => p.lugar.id);",
                  "pm.collectionVariables.set(\"lugar_ids\", JSON.stringify(ids));",
                  "pm.collectionVariables.set(\"lugar_ids_invertidos\", JSON.stringify([...ids].reverse()));",
                  "pm.test(\"Respeta el presupuesto\", () => pm.expect(pm.response.json().costo_total_clp).to.be.at.most(15000));"
                ]
              }
            }
          ]
        },
