    {
      "name": "Demo (orden de la presentación)",
      "item": [
        {
          "name": "1. Crear lugar (POST → 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/lugares",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "lugares"
              ]
            },
            "description": "Crea un lugar nuevo. Guarda su id en la variable lugar_id para las siguientes peticiones.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"barrio-lastarria\",\n  \"categoria\": \"historico\",\n  \"nombre_es\": \"Barrio Lastarria\",\n  \"nombre_en\": \"Lastarria Neighborhood\",\n  \"descripcion_es\": \"Barrio patrimonial con cafés, librerías y galerías.\",\n  \"descripcion_en\": \"Heritage neighborhood with cafés, bookshops and galleries.\",\n  \"comuna\": \"Santiago\",\n  \"latitud\": -33.4372,\n  \"longitud\": -70.6386,\n  \"costo_clp\": 0,\n  \"duracion_min\": 45,\n  \"horario_es\": \"Lun-Dom 10:00-20:00\",\n  \"horario_en\": \"Mon-Sun 10:00-20:00\",\n  \"contenido_rotativo\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set(\"lugar_id\", d.id);",
                  "pm.test(\"Devuelve cabecera Location\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Leer lugar (GET → 200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/lugares/{{lugar_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "lugares",
                "{{lugar_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es el lugar creado\", () => pm.expect(pm.response.json().slug).to.eql(\"barrio-lastarria\"));"
                ]
              }
            }
          ]
        },
